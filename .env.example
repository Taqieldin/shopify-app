# Multi-Tenant Shopify SaaS Configuration
PORT=3000
NODE_ENV=development

# Shopify App Credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
SHOPIFY_SCOPES=read_products,write_products,read_customers,read_orders

# Database (SQLite for local development / PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Session & Cryptographic Secrets
SESSION_SECRET=development_session_secret_min_32_characters_long
ENCRYPTION_KEY=development_encryption_key_32_bytes_len!
WEBHOOK_SECRET=development_shopify_webhook_secret

# Object Storage (S3 Compatible - Optional for MVP)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Transactional Email (Optional for MVP - falls back to simulated logger)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="concierge@digitalpassport.app"
