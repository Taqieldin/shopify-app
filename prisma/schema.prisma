generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model PhysicalPiece {
  id                   String         @id @default(cuid())
  serial               String         @unique
  model_name           String
  color                String
  material             String
  size                 String
  hardware             String
  weight               String
  manufacturing_year   Int
  purchase_date        DateTime?
  warranty_until       DateTime?
  service_status       String         @default("NOT_IN_SERVICE")
  has_service_history  Boolean        @default(false)
  service_count        Int            @default(0)
  last_service_date    DateTime?
  authentication_status String        @default("UNVERIFIED")
  nfc_tag_id           String?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  nfc_tag          NfcTag?
  service_records  ServiceRecord[]
}

model NfcTag {
  id            String   @id @default(cuid())
  tag_uid       String   @unique
  tag_id        String   @unique
  status        String   @default("UNREGISTERED")
  piece_id      String?  @unique
  registered_at DateTime @default(now())

  piece PhysicalPiece? @relation(fields: [piece_id], references: [id])
}

model ServiceRecord {
  id           String   @id @default(cuid())
  piece_id     String
  service_date DateTime
  service_type String
  notes        String?
  created_at   DateTime @default(now())

  piece PhysicalPiece @relation(fields: [piece_id], references: [id])
}
